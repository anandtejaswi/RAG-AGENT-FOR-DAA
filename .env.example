# ==============================================================================
# Model Provider Configuration
# ==============================================================================
# Supported providers: "openai_compat" (e.g. OpenRouter, OpenAI, vLLM) or "google_genai"
LLM_PROVIDER=openai_compat
LLM_MODEL=z-ai/glm-5.3-flash
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_or_openai_api_key_here

# Alternative Google Gemini Configuration:
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your_gemini_api_key_here

# ==============================================================================
# LangChain / LangSmith Tracing
# ==============================================================================
# Set to "true" to enable full telemetry tracing for LLM, tools, and agent calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-aktu
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==============================================================================
# Server & Embedding Cache Settings (Optional)
# ==============================================================================
PORT=8000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
