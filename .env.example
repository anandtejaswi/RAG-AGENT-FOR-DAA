# ==============================================================================
# Model Provider Configuration
# ==============================================================================
# Supported providers: "openai_compat" (e.g. OpenRouter, vLLM) or "google_genai"
MUNSHI_MODEL_PROVIDER=openai_compat
MUNSHI_MODEL=z-ai/glm-5.3-flash
MUNSHI_MODEL_BASE_URL=https://openrouter.ai/api/v1
MUNSHI_MODEL_API_KEY=your_openrouter_or_openai_api_key_here

# Alternative Google Gemini Configuration:
# MUNSHI_MODEL_PROVIDER=google_genai
# MUNSHI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your_gemini_api_key_here

# ==============================================================================
# LangChain / LangSmith Tracing
# ==============================================================================
# Set to "true" to enable full telemetry tracing for LLM, tools, and agent calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-aktu
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
PORT=8000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
